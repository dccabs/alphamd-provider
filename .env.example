# Supabase project shared with the main alphamd app (dhzfxcssjunzkfsfyvyu).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This app's own origin, per environment. Used to build the password-reset
# redirect (`${NEXT_PUBLIC_SITE_URL}/auth/callback`). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Optional. Comma/whitespace separated exact addresses allowed in addition to
# @alphamd.org, e.g. "contractor@example.com". Parsed once at module load, so
# changes require a redeploy. Leave unset unless you need an exception.
PROVIDER_ALLOWED_EMAILS=

# Service-role key, required by /lab-reviews only.
#
# Every table that screen reads is gated by RLS on is_admin_or_employee(), which
# checks the legacy user_list.role column — and no account in production has
# user_list.role = 'provider'. A real provider reading through RLS therefore
# gets empty arrays rather than an error, which is the worst failure mode
# possible on a clinical screen. So the portal reads with the service role and
# enforces authorization in application code (src/lib/authz.ts), off
# user_roles_join.
#
# This key is read in exactly one module (src/lib/supabase/admin.ts), which
# imports 'server-only'; an ESLint rule additionally bans importing it from
# client components. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Zendesk. Needed only to SEND a customer-service reply — the thread itself is
# read from the zendesk_last_contact table, not the API.
ZENDESK_API_TOKEN=
# Optional; both default to the values the main app uses.
ZENDESK_API_EMAIL=
ZENDESK_DOMAIN=
